# Required: use a unique secret in every environment. Keep this server-side.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Required for AI try-on. Never use a PUBLIC_ or VITE_ prefix.
FASHN_API_KEY=
# Optional override; defaults to https://api.fashn.ai/v1
TRYON_API_URL=

# Persistent storage: configure either MonstarX storage or all four R2 credentials.
# MonstarX-managed deployments supply MONSTARX_DATA_TOKEN and MONSTARX_*_URL themselves.
MONSTARX_DATA_URL=
MONSTARX_DATA_TOKEN=
MONSTARX_STORAGE_URL=

# Cloudflare R2 S3-compatible credentials (server-side only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public domain for objects stored under public/.
R2_PUBLIC_BASE_URL=
