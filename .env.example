# Required: use a unique secret in every environment. Keep this server-side.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# ── AI try-on ─────────────────────────────────────────────────────────────
# Default provider: PixelAPI (https://pixelapi.dev). Server-side only — never PUBLIC_ or VITE_.
PIXELAPI_API_KEY=
# Optional override; defaults to https://api.pixelapi.dev
PIXELAPI_API_URL=
# Optional: force a provider ("pixelapi" or "fashn"). Defaults to PixelAPI when its key is set.
TRYON_PROVIDER=
# Optional fallback provider (FASHN). Leave empty unless TRYON_PROVIDER=fashn.
FASHN_API_KEY=
TRYON_API_URL=

# ── Image storage: Cloudinary (private, served through /api/files) ────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix inside your Cloudinary account (default: fitroom)
CLOUDINARY_FOLDER=

# ── Database (required for sign-in and saved fits on Netlify) ─────────────
# Cloudflare D1 only exists in the Cloudflare Workers build. On Netlify use the MonstarX data proxy.
MONSTARX_DATA_URL=
MONSTARX_DATA_TOKEN=

# Legacy storage backends — only used when the CLOUDINARY_* variables are not set.
MONSTARX_STORAGE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Free fallback try-on (Hugging Face Space, IDM-VTON). Create a read token at huggingface.co/settings/tokens
HF_TOKEN=
HF_TRYON_SPACE=yisol-idm-vton
